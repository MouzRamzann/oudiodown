# RapidAPI key — sign up at https://rapidapi.com and subscribe to
# "Instagram Scraper Stable API" (instagram-scraper-stable-api.p.rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# RapidAPI host — copy from the X-RapidAPI-Host header on your subscribed API page
RAPIDAPI_HOST=instagram-scraper-stable-api.p.rapidapi.com

# Endpoint path for reel data — copy the path from "Detailed Reel Data" endpoint
RAPIDAPI_ENDPOINT=/get_media_data.php
